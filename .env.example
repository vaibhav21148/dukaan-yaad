# All free tiers. Copy to .env.local for `vercel dev`, or add in Vercel > Project > Settings > Environment Variables.
# Never commit real keys.

# --- LLM (note extraction + Ask) ---
LLM_PROVIDER=gemini                 # gemini (default) | groq | anthropic
GEMINI_API_KEY=AQ.Ab8RN6LLj8hRX9BmSMfb-3Qp7NZyA45CJ9EanGBZX8eLvn_ilA                     # Google AI Studio -> Get API key (free, no card)
GEMINI_MODEL=gemini-3.1-flash-lite  # check https://ai.google.dev/gemini-api/docs/models
GROQ_API_KEY=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                       # console.groq.com -> API Keys (free; 429 over limit, never a charge)
GROQ_MODEL=openai/gpt-oss-20b       # must support JSON / structured output
LLM_TIMEOUT_MS=8000

# --- Online speech-to-text ---
SARVAM_API_KEY=sk_6x9s1311_4VplQXIVLhmeyQ2MVtKMrsre                     # dashboard.sarvam.ai -> API keys (free signup credits, then pay-per-use)
SARVAM_MODEL=saaras:v3              # saaras:v3 or saaras:v4; both support mode=codemix
